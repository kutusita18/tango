<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#101827">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="単語">
<meta name="mobile-web-app-capable" content="yes">
<title>単語</title>
<style>
:root{--bg:#f4f6fb;--card:#fff;--ink:#172033;--muted:#697386;--line:#e4e8f0;--accent:#5b5bd6;--accent2:#ececff;--green:#137a55;--greenbg:#e3f7ee;--amber:#946200;--amberbg:#fff4d6;--red:#b42335;--redbg:#ffeaed;--shadow:0 8px 24px #1b2b4b0c}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Noto Sans JP",sans-serif;line-height:1.5}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0;border-radius:13px;padding:12px 14px;font-weight:700}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #8b8bff;outline-offset:2px}.app{max-width:760px;margin:auto;padding:16px 14px 36px}.top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:6px 0 16px}.brand{display:flex;align-items:center;gap:10px}.logo{width:43px;height:43px;border-radius:14px;background:#222445;color:white;display:grid;place-items:center;font-size:22px}.brand h1{font-size:20px;margin:0}.sub{font-size:12px;color:var(--muted)}.pill{background:#e8eaff;color:#3e3ea4;padding:5px 9px;border-radius:999px;font-size:12px;font-weight:800}.tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;background:#e9edf5;padding:5px;border-radius:15px;margin-bottom:14px}.tab{background:transparent;color:#596174;padding:10px 4px;font-size:13px}.tab.active{background:#fff;color:#292a61;box-shadow:0 2px 6px #15203a12}.panel{display:none}.panel.active{display:block}.card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:17px;margin-bottom:13px;box-shadow:var(--shadow)}.row{display:flex;align-items:center;gap:9px}.between{justify-content:space-between}.wrap{flex-wrap:wrap}.muted{color:var(--muted)}.small{font-size:12px}.tiny{font-size:11px}.h2{font-size:17px;margin:0 0 12px}.h3{font-size:14px;margin:0 0 8px}.statgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{background:#f7f8fc;border-radius:14px;padding:12px}.stat strong{display:block;font-size:23px;letter-spacing:-.5px}.stat span{font-size:11px;color:var(--muted)}.progress{height:6px;background:#e9edf5;border-radius:99px;overflow:hidden}.progress>div{height:100%;background:#5b5bd6;width:0;transition:width .2s}.field{display:flex;flex-direction:column;gap:5px;margin-bottom:11px;min-width:0;flex:1}.field label{font-size:12px;font-weight:800;color:#586174}.field input,.field select,.field textarea{width:100%;border:1px solid #d9deea;background:white;border-radius:11px;padding:11px;color:var(--ink);min-width:0}.field textarea{min-height:130px;resize:vertical}.primary{background:var(--accent);color:white}.secondary{background:#eef0f7;color:#343a50}.outline{background:white;border:1px solid #d9deea;color:#343a50}.green{background:var(--greenbg);color:var(--green)}.amber{background:var(--amberbg);color:var(--amber)}.red{background:var(--redbg);color:var(--red)}.full{width:100%}.wordstage{text-align:center;padding:26px 12px 18px}.word{font-size:clamp(32px,9vw,48px);font-weight:800;letter-spacing:.01em;overflow-wrap:anywhere;margin:8px 0}.pron{color:var(--muted);font-size:14px}.chip{font-size:11px;border:1px solid var(--line);padding:4px 8px;border-radius:999px;color:#5d6678}.rategrid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px}.rategrid button{padding:14px 5px}.answer{border-top:1px solid var(--line);padding-top:16px;margin-top:14px;text-align:left}.answer h3{font-size:23px;margin:0 0 8px;text-align:center}.detailbox{background:#f7f8fc;border-radius:13px;padding:12px;margin:10px 0;font-size:13px}.detailbox b{display:block;margin-bottom:3px}.hidden{display:none!important}.listitem{padding:11px 0;border-bottom:1px solid var(--line)}.listitem:last-child{border:0}.wordmini{font-size:18px;font-weight:800}.empty{text-align:center;padding:25px 12px;color:var(--muted)}.notice{background:#f0f2ff;border:1px solid #dedfff;padding:12px;border-radius:13px;font-size:12px;color:#44457c}.dangertext{color:var(--red)}.chartbars{display:flex;align-items:end;gap:7px;height:100px;padding:8px 0}.barwrap{flex:1;text-align:center;font-size:10px;color:var(--muted)}.bar{background:#7474df;border-radius:6px 6px 2px 2px;min-height:3px;width:100%;margin-bottom:5px}.footer{text-align:center;color:var(--muted);font-size:11px;padding:12px}.settingsgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}@media(max-width:420px){.app{padding:12px 10px 28px}.card{padding:14px}.tab{font-size:12px}.stat strong{font-size:20px}.settingsgrid{grid-template-columns:1fr}.rategrid button{font-size:13px}}
.ai-preview-list{display:grid;gap:8px;margin-top:10px}.ai-preview-item{display:flex;gap:10px;align-items:flex-start;padding:10px;border:1px solid var(--line,#ddd);border-radius:10px;background:var(--card,#fff)}.ai-preview-item input{margin-top:4px;flex:0 0 auto}.ai-preview-item .word-detail{min-width:0;flex:1}.ai-preview-item .word-detail strong{display:block;font-size:1rem}.ai-preview-item .word-detail small{display:block;color:var(--muted,#666);margin-top:3px;line-height:1.5}.preview-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}

.answerMetaRow{display:grid;grid-template-columns:minmax(7em,auto) 1fr;gap:10px;padding:5px 0;border-bottom:1px solid var(--line,#e8e8e8);text-align:left}.answerMetaRow:last-child{border-bottom:0}.answerMetaRow b{color:var(--muted,#666)}.answerMetaRow span{white-space:pre-wrap;overflow-wrap:anywhere}
.detailIllustration{margin:0 0 12px;text-align:center}.detailIllustration img{display:block;max-width:100%;max-height:220px;height:auto;object-fit:contain;border-radius:12px;margin:auto}.detailIllustration figcaption{font-size:11px;color:var(--muted);margin-top:4px}</style>
</head>
<body>
<div class="app">
<header class="top">
  <div class="brand"><div class="logo">単</div><div><h1>単語</h1><div class="sub">Vocabulary practice</div></div></div>
  <span class="pill" id="saveState">端末に保存</span>
</header>
<nav class="tabs" aria-label="メインメニュー">
  <button class="tab active" data-tab="study">学習</button>
  <button class="tab" data-tab="review">復習</button>
  <button class="tab" data-tab="progress">成長</button>
  <button class="tab" data-tab="library">単語庫</button>
</nav>

<section class="panel active" id="panel-study">
  <div class="card">
    <div class="row between wrap"><h2 class="h2" style="margin:0">今日の学習</h2><span class="chip" id="todayLabel"></span></div>
    <div class="statgrid" style="margin:14px 0">
      <div class="stat"><strong id="dueCount">0</strong><span>復習待ち</span></div>
      <div class="stat"><strong id="newCount">0</strong><span>未学習</span></div>
      <div class="stat"><strong id="todayCount">0</strong><span>今日の回答</span></div>
    </div>
    <div class="row between small muted"><span>今日の目標</span><span id="goalText">20語</span></div>
    <div class="progress" style="margin-top:7px"><div id="goalBar"></div></div>
  </div>
  <div class="card">
    <div class="row between wrap"><h2 class="h2" style="margin:0">学習セット</h2><span class="chip" id="queueLabel">通常学習</span></div>
    <div class="settingsgrid" style="margin-top:12px">
      <div class="field"><label for="langFilter">言語</label><select id="langFilter"><option value="ko">韓国語</option><option value="en">英語</option><option value="zh">中国語</option><option value="all">全言語</option></select></div>
      <div class="field"><label for="topicFilter">テーマ</label><select id="topicFilter"><option value="all">すべて</option><option>家族</option><option>感情・心理</option><option>日常生活</option><option>時間</option><option>数字</option><option>人間関係</option><option>住まい</option><option>学校・学習</option><option>仕事</option><option>買い物</option><option>食事</option><option>自然・天気</option><option>旅行</option><option>位置</option><option>基本表現</option><option>感覚・評価</option><option>健康</option><option>運動・スポーツ</option><option>移動</option><option>会話</option><option>頻度</option><option>考え・議論</option><option>社会</option></select></div>
    </div>
    <div class="settingsgrid">
      <div class="field"><label for="levelFilter">レベル</label><select id="levelFilter"><option value="all">すべて</option><option>入門</option><option>文法基礎</option><option>初級</option><option>中級</option><option>上級</option></select></div>
      <div class="field"><label for="direction">出題方向</label><select id="direction"><option value="foreign">外国語 → 意味</option><option value="native">日本語 → 外国語</option></select></div>
    </div>
    <div class="row wrap" style="margin-top:12px;align-items:end"><div class="field" style="flex:1;min-width:220px"><label for="sequenceSet">順番で学ぶセット</label><select id="sequenceSet"><option value="nativeNumbers">数字：固有数詞 1〜10</option><option value="weekdays">曜日（月曜日〜日曜日）</option><option value="sinoNumbers">数字：漢数詞 1〜10</option></select></div><button class="outline" id="sequenceStartBtn">順番学習を開始</button></div><p class="tiny muted">順番学習では一覧の順に覚えたあと、ランダムテストで確認できます。</p><p class="tiny muted">入門は文の土台になる基本語、文法基礎は助詞など、順番学習は数字や曜日のセットです。初級からは場面ごとの名詞や動詞を広げます。</p>
    <div class="row between small muted"><span id="setDescription">韓国語 · すべて</span><span id="position">0 / 0</span></div>
    <div class="progress" style="margin-top:7px"><div id="setBar"></div></div>
  </div>
  <div class="card" id="studyCard">
    <div class="row between wrap"><span class="chip" id="wordMeta">名詞 · 家族</span><span class="small muted" id="wordIndex"></span></div>
    <div class="wordstage">
      <div class="word" id="frontWord">가족</div>
      <div class="pron" id="pronunciation">gajok</div>
      <p class="muted small" id="studyHint">意味を頭の中で思い出してから、自己評価を選んでください。</p>
      <div class="answer hidden" id="answerBox">
        <h3 id="meaning">家族</h3>
        <div class="row wrap" style="justify-content:center;margin-bottom:10px"><span class="chip" id="answerLang"></span><span class="chip" id="answerTopic"></span></div>
        <div id="quickExplanation" class="detailbox"></div>
        <div id="deepExplanation" class="detailbox hidden"></div>
      </div>
      <div class="rategrid" id="rateGrid">
        <button class="green" data-rate="known">わかる</button>
        <button class="amber" data-rate="unsure">不安</button>
        <button class="red" data-rate="unknown">わからない</button>
      </div>
      <div class="row hidden" id="navGrid" style="margin-top:14px">
        <button class="primary" id="nextBtn" style="flex:1">次へ</button>
        <button class="outline" id="detailBtn" style="flex:1">詳しく解説</button>
      </div>
      <div class="hidden" id="correctionActions" style="margin-top:9px">
        <button class="red full" id="correctionBtn">わからなかった</button>
        <p class="tiny muted" style="text-align:center;margin:5px 0 0">数問後にもう一度出題します。</p>
      </div>
      <div class="row hidden" id="sequenceFinishActions" style="margin-top:12px"><button class="primary full" id="sequenceFinishBtn">ランダムテストへ</button></div><p class="tiny muted" id="rateHint" style="text-align:center;margin:8px 0 0">意味を思い出してから、自己評価を選んでください。</p>
    </div>
  </div>
  <p class="footer">回答と復習予定はこの端末のブラウザ内に保存されます。</p>
</section>

<section class="panel" id="panel-review">
  <div class="card"><h2 class="h2">復習センター</h2><p class="muted small">復習期限を過ぎた単語と、苦手語を優先して学習します。</p>
    <div class="statgrid"><div class="stat"><strong id="reviewDue">0</strong><span>期限到来</span></div><div class="stat"><strong id="reviewWeak">0</strong><span>苦手語</span></div><div class="stat"><strong id="reviewLearned">0</strong><span>学習中以上</span></div></div>
    <button class="primary full" style="margin-top:14px" id="startReviewBtn">復習を開始</button>
  </div>
  <div class="card"><h3 class="h3">復習間隔の考え方</h3><div class="listitem"><b>わかる・正解</b><div class="small muted">正解を重ねると復習間隔を延ばします。</div></div><div class="listitem"><b>不安</b><div class="small muted">短めの間隔で再確認します。</div></div><div class="listitem"><b>わからない</b><div class="small muted">解説を確認し、数問後に再テスト。復習間隔も短く戻します。</div></div><p class="tiny muted">間隔は学習支援用の実用的なルールであり、忘却曲線を厳密に予測するものではありません。</p></div>
  <div class="card"><h3 class="h3">苦手語リスト</h3><div id="weakList" class="muted small">まだ記録がありません。</div></div>
</section>

<section class="panel" id="panel-progress">
  <div class="card"><h2 class="h2">成長ダッシュボード</h2><div class="statgrid"><div class="stat"><strong id="totalWords">0</strong><span>登録単語</span></div><div class="stat"><strong id="masteredWords">0</strong><span>定着候補</span></div><div class="stat"><strong id="accuracy">—</strong><span>直近の正答率</span></div></div></div>
  <div class="card"><h3 class="h3">過去7日間の回答数</h3><div class="chartbars" id="weeklyChart"></div></div>
  <div class="card"><h3 class="h3">言語別の登録語彙</h3><div id="languageStats"></div></div>
  <div class="card"><h3 class="h3">学習の内訳</h3><div id="ratingStats" class="small muted"></div></div>
</section>

<section class="panel" id="panel-library">
  <div class="card"><h2 class="h2">単語庫とAI一括生成</h2><p class="muted small">単語は端末内に保存されます。AI生成は、このアプリから外部AIへ直接接続せず、ChatGPTで生成したJSONを取り込む方式です。APIキーなしで安全に始められます。</p>
    <div class="settingsgrid">
      <div class="field"><label for="genLang">言語</label><select id="genLang"><option value="ko">韓国語</option><option value="en">英語</option><option value="zh">中国語</option></select></div>
      <div class="field"><label for="genLevel">レベル</label><select id="genLevel"><option>指定なし</option><option>入門</option><option>初級</option><option>中級</option><option>上級</option></select></div>
      <div class="field"><label for="genTopic">場面・テーマ（自由入力）</label><input id="genTopic" value="" placeholder="例：感情・心理、哲学、ネイティブの日常表現"></div>
      <div class="field"><label for="genPos">品詞</label><select id="genPos"><option>すべて</option><option>名詞</option><option>動詞</option><option>形容詞</option><option>副詞</option><option>表現</option></select></div>
    </div>
    <div class="field"><label for="genCount">1回に生成する単語数</label><select id="genCount"><option>20</option><option selected>50</option><option>100</option></select></div>
    <button class="primary full" id="promptBtn">AI生成用プロンプトを作る</button>
    <div class="field" style="margin-top:12px"><label for="promptOutput">ChatGPTに貼り付けるプロンプト</label><textarea id="promptOutput" placeholder="上のボタンを押すと、生成用プロンプトがここに表示されます。"></textarea></div>
    <button class="outline full" id="copyPromptBtn">プロンプトをコピー</button>
  </div>
  <div class="card" id="aiGenerateCard"><h3 class="h3">AIから直接生成</h3><p class="small muted">安全なAI中継APIを設定すると、アプリ内で単語を生成して確認・取り込みできます。APIキーはこの画面やHTMLに保存しません。</p>
    <div class="field"><label for="aiEndpoint">AI中継APIのURL</label><input id="aiEndpoint" type="url" placeholder="https://your-worker.example.workers.dev/api/generate" autocomplete="url"></div>
    <div class="small muted">URLはこのブラウザ内だけに保存されます。APIキーはサーバー側のSecretとして設定してください。</div>
    <button class="outline full" id="saveEndpointBtn" style="margin-top:8px">API URLを保存</button>
    <button class="primary full" id="directGenerateBtn" style="margin-top:8px">設定した条件でAI生成</button>
    <div id="aiStatus" class="small" style="margin-top:10px" aria-live="polite"></div>
    <div class="field hidden" id="aiPreviewWrap" style="margin-top:12px"><label>生成結果の確認（追加したい単語を選択）</label><div class="small muted" id="aiPreviewSummary"></div><div class="preview-actions"><button class="outline" type="button" id="selectAllAiBtn">すべて選択</button><button class="outline" type="button" id="selectNoneAiBtn">すべて解除</button></div><div id="aiPreviewList" class="ai-preview-list"></div><details style="margin-top:10px"><summary class="small muted">生成データJSONを確認・編集</summary><textarea id="aiPreview" rows="8" style="margin-top:8px"></textarea></details><button class="primary full" id="importAiPreviewBtn" style="margin-top:8px">選択した単語を単語帳に追加</button></div>
  </div>
  <div class="card"><h3 class="h3">AIが生成したJSONを取り込む</h3><p class="small muted">ChatGPTで生成したJSONもここから取り込めます。既存語は言語＋見出し語で重複を防ぎます。</p>
    <div class="field"><label for="jsonInput">単語データ（JSON配列）</label><textarea id="jsonInput" placeholder='[{"lang":"ko","word":"가족","pron":"gajok","meaning":"家族","pos":"名詞","level":"初級","topic":"家族","example":"우리 가족은 네 명이에요.","translation":"私の家族は4人です。","parts":"漢字語「家族」に対応する語","related":"부모（親）","opposite":"特定の対義語なし"}]'></textarea></div>
    <div class="row"><button class="primary" style="flex:1" id="importBtn">単語を取り込む</button><button class="outline" id="exportBtn" style="flex:1">全データを書き出す</button></div>
    <div id="importMessage" class="small" style="margin-top:10px" aria-live="polite"></div>
  </div>
  <div class="card"><div class="row between"><h3 class="h3" style="margin:0">登録済み単語</h3><span class="chip" id="libraryCount">0語</span></div><div id="libraryList"></div>
    <div class="row wrap" style="margin-top:12px"><button class="outline" id="sampleBtn">サンプル単語を追加</button><button class="outline" id="backupBtn">バックアップJSONを表示</button><button class="red" id="resetBtn">全データを削除</button></div>
    <div class="field hidden" id="backupWrap" style="margin-top:12px"><label for="backupOutput">バックアップデータ</label><textarea id="backupOutput"></textarea><button class="outline" id="downloadBackupBtn">JSONファイルを保存</button></div>
  </div>
</section>
</div>
<script>
const STORE='kotobalab_v01_local';
const localDate=(d=new Date())=>{const y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0'),day=String(d.getDate()).padStart(2,'0');return `${y}-${m}-${day}`;};
const today=()=>localDate();
const datePlus=(days)=>{const d=new Date();d.setDate(d.getDate()+days);return localDate(d)};
const idFor=(lang,word)=>lang+'::'+String(word).trim().toLowerCase();
const langName={ko:'韓国語',en:'英語',zh:'中国語'};
const LEVELS=['入門','文法基礎','順番学習','初級','中級','上級'];
const VOCAB_LEVELS=['入門','初級','中級','上級'];
const FREQUENCY_LABELS=['最優先','高頻度','一般'];
const BEGINNER_CORE=new Set("가게 가다 가족 감사합니다 같이 거기 공부하다 괜찮아요 그것 그래서 그리고 나 내일 네 누구 돈 되다 듣다 마시다 만나다 많다 많이 말하다 맛있다 먹다 모르다 물 뭐 미안해요 받다 밥 방 병원 보다 사다 사람 살다 선생님 시간 식당 아니다 아니요 아침 아프다 안녕하세요 알다 어디 어떻게 어제 언제 얼마 없다 여기 오늘 오다 왜 우리 음식 이것 이다 이름 일 있다 자주 작다 저 저것 저기 저녁 적다 점심 조금 좋다 좋아하다 죄송합니다 주다 주세요 지금 집 친구 크다 필요하다 하다 하루 하지만 학교 학생".split(/\s+/));
const GRAMMAR_CORE=new Set("은/는 이/가 을/를 에 에서 도 의 와/과 하고 (으)로 에게 부터 까지 안 못".split(/\s+/));
const SEQUENCE_SETS={
  nativeNumbers:{label:'数字・固有数詞 1〜10',topic:'数字',words:['하나','둘','셋','넷','다섯','여섯','일곱','여덟','아홉','열']},
  weekdays:{label:'曜日（月→日）',topic:'曜日',words:['월요일','화요일','수요일','목요일','금요일','토요일','일요일']},
  sinoNumbers:{label:'数字・漢数詞 1〜10',topic:'数字',words:['일','이','삼','사','오','육','칠','팔','구','십']}
};
function classifyWord(w){
  if(!w||w.lang!=='ko') return w;
  const word=String(w.word||'').trim();
  const topic=String(w.topic||''); const meaning=String(w.meaning||'');
  const sequence=w.studySet&&SEQUENCE_SETS[w.studySet]?{key:w.studySet,set:SEQUENCE_SETS[w.studySet],order:SEQUENCE_SETS[w.studySet].words.indexOf(word)}:null;
  if(sequence){w.level='順番学習';w.topic=sequence.set.topic;w.studySet=sequence.key;w.sequenceOrder=sequence.order+1;return w;}
  if(GRAMMAR_CORE.has(word)){w.level='文法基礎';w.topic='文法基礎';w.studySet='grammarBasics';return w;}
  delete w.studySet;delete w.sequenceOrder;
  if(BEGINNER_CORE.has(word)) w.level='入門';
  else if(ADVANCED_CORE.has(word) || /哲学|論理|認識|存在|本質|抽象|社会理論|専門/.test(topic+meaning)) w.level='上級';
  else if(w.level==='初中級'||w.level==='入門') w.level='初級';
  else if(!LEVELS.includes(w.level)) w.level='初級';
  return w;
}
