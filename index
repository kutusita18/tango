$('downloadBackupBtn').addEventListener('click',()=>{const blob=new Blob([exportData()],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='単語-backup-'+today()+'.json';a.click();URL.revokeObjectURL(a.href);});
$('sampleBtn').addEventListener('click',()=>{let n=0;samples.forEach(w=>{const id=idFor(w.lang,w.word);if(!db.words.some(x=>x.id===id)){db.words.push({...w,id,createdAt:today(),seen:0,known:0,unsure:0,unknown:0,streak:0,interval:0,due:today(),lastSeen:null,mastered:false});n++;}});save();renderLibrary();renderDashboard();$('importMessage').textContent=`サンプルを確認し、${n}語追加しました。`});
$('resetBtn').addEventListener('click',()=>{if(confirm('単語・復習予定・回答履歴をすべて削除します。この操作は取り消せません。バックアップはありますか？')){localStorage.removeItem(STORE);db={words:[],reviews:[],events:[],settings:{goal:20}};load();startNormal();renderLibrary();renderProgress();renderReview();$('importMessage').textContent='データを初期化しました。';}});
