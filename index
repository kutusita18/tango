function safeIllustrationPath(value){const src=String(value??'').trim();if(src.startsWith('builtin:')){const svg=BUILTIN_ILLUSTRATIONS[src.slice(8)];return svg?'data:image/svg+xml;charset=utf-8,'+encodeURIComponent(svg):'';}const prefix='images/illustrations/';if(!src.startsWith(prefix)||src.includes('..'))return '';const name=src.slice(prefix.length);return /^[a-z0-9_-]+\.(svg|png|webp|jpe?g)$/i.test(name)?src:'';}
function deepExplanationData(w){if(!w)return {available:false,html:''};const image=safeIllustrationPath(w.illustration);const rows=[['例文',w.example],['日本語訳',w.translation],['使い方のポイント',w.usageNote],['覚え方のヒント',usefulWordHint(w)]].filter(([,value])=>String(value??'').trim());const imageHtml=image?'<figure class="detailIllustration"><img src="'+esc(image)+'" alt="'+esc(w.illustrationAlt||w.word+'のイラスト')+'" loading="lazy"><figcaption>イメージ</figcaption></figure>':'';const rowsHtml=rows.map(([label,value])=>'<div class="answerMetaRow"><b>'+esc(label)+'</b><span>'+esc(value)+'</span></div>').join('');const available=Boolean(image||rows.length);return {available,html:available?imageHtml+rowsHtml:'<p class="small muted">この単語の補足は準備中です。</p>'};}
$('detailBtn').addEventListener('click',()=>{detailOpen=!detailOpen;$('deepExplanation').classList.toggle('hidden',!detailOpen);$('detailBtn').textContent=detailOpen?'解説を閉じる':'詳しく解説';});
document.querySelectorAll('[data-rate]').forEach(btn=>btn.addEventListener('click',()=>rate(btn.dataset.rate)));
function scheduleUnknownRetest(w){const insertAt=Math.min(queuePos+4,currentQueue.length);const shiftedPositions=[...ratedPositions].filter(i=>i>=insertAt).sort((a,b)=>b-a);shiftedPositions.forEach(i=>{ratedPositions.delete(i);ratedPositions.add(i+1);});const shiftedRates=[...rateByPosition.entries()].filter(([i])=>i>=insertAt).sort((a,b)=>b[0]-a[0]);shiftedRates.forEach(([i,v])=>{rateByPosition.delete(i);rateByPosition.set(i+1,v);});currentQueue.splice(insertAt,0,w);}
function correctKnownToUnknown(){if(!current||!ratedCurrent||rateByPosition.get(queuePos)!=='known')return;const w=current;w.known=Math.max(0,(w.known||0)-1);w.unknown=(w.unknown||0)+1;w.streak=0;w.interval=1;w.due=datePlus(1);w.mastered=false;rateByPosition.set(queuePos,'unknown');const event=[...db.events].reverse().find(e=>e.id===w.id&&e.rate==='known'&&e.date===today());if(event)event.rate='unknown';else db.events.push({date:today(),id:w.id,rate:'unknown',lang:w.lang});scheduleUnknownRetest(w);$('correctionActions').classList.add('hidden');$('studyHint').textContent='「わからなかった」に訂正しました。数問後にもう一度出題します。';$('rateHint').textContent='訂正を記録しました。答えを確認して「次へ」を押してください。';save();renderDashboard();}
function rate(r){if(!current||ratedCurrent)return;ratedCurrent=true;ratedPositions.add(queuePos);rateByPosition.set(queuePos,r);document.querySelectorAll('[data-rate]').forEach(b=>b.disabled=true);$('rateGrid').classList.add('hidden');$('navGrid').classList.remove('hidden');$('answerBox').classList.remove('hidden');$('correctionActions').classList.toggle('hidden',r!=='known');const w=current;w.seen=(w.seen||0)+1;w.lastSeen=today();w[r]=(w[r]||0)+1;let delay=1;if(r==='known'){w.streak=(w.streak||0)+1;w.interval=w.interval?Math.min(180,Math.round(w.interval*2.2)):1;delay=w.interval;w.mastered=w.streak>=3&&w.interval>=7;}if(r==='unsure'){w.streak=0;w.interval=Math.max(1,Math.round((w.interval||2)*0.55));delay=Math.min(3,Math.max(1,w.interval));}if(r==='unknown'){w.streak=0;w.interval=1;delay=1;}w.due=datePlus(delay);db.events.push({date:today(),id:w.id,rate:r,lang:w.lang});if(db.events.length>5000)db.events=db.events.slice(-5000);save();renderDashboard();
$('meaning').textContent=$('direction').value==='native'?w.word:w.meaning;
if(r==='known'){$('studyHint').textContent='「わかる」を記録しました。答えを確認してから次へ進めます。';$('rateHint').textContent='答えを確認して「次へ」を押してください。';}
else {$('studyHint').textContent=r==='unsure'?'「不安」を記録しました。答えを確認しましょう。':'「わからない」を記録しました。数問後に再テストします。';$('rateHint').textContent='答えを確認して「次へ」を押してください。';}
if(r==='unknown')scheduleUnknownRetest(w);
}
$('nextBtn').addEventListener('click',()=>{if(!current)return;if(!ratedCurrent)return;queuePos++;renderCard();renderDashboard();});
$('sequenceStartBtn').addEventListener('click',startSequenceLearn);$('sequenceFinishBtn').addEventListener('click',()=>{if(sequencePhase==='learn')startSequenceQuiz();else startSequenceLearn();});
$('correctionBtn').addEventListener('click',correctKnownToUnknown);
['langFilter','topicFilter','levelFilter','direction'].forEach(id=>$(id).addEventListener('change',()=>startNormal()));
$('startReviewBtn').addEventListener('click',startReview);
function renderDashboard(){const all=filteredWords();$('dueCount').textContent=all.filter(w=>w.seen>0&&w.due<=today()).length;$('newCount').textContent=all.filter(w=>!w.seen).length;const todayEvents=db.events.filter(e=>e.date===today());$('todayCount').textContent=todayEvents.length;$('goalText').textContent=(db.settings.goal||20)+'語';$('goalBar').style.width=Math.min(100,todayEvents.length/(db.settings.goal||20)*100)+'%';$('todayLabel').textContent=new Date().toLocaleDateString('ja-JP',{month:'numeric',day:'numeric',weekday:'short'});}
function renderReview(){const all=filteredWords();$('reviewDue').textContent=all.filter(w=>w.seen>0&&w.due<=today()).length;$('reviewWeak').textContent=all.filter(w=>w.unknown>0||w.unsure>0).length;$('reviewLearned').textContent=all.filter(w=>w.seen>0).length;const weak=all.filter(w=>w.unknown>0||w.unsure>0).sort((a,b)=>(b.unknown+b.unsure)-(a.unknown+a.unsure)).slice(0,12);$('weakList').innerHTML=weak.length?weak.map(w=>`<div class="listitem row between"><div><b>${esc(w.word)}</b><div class="small muted">${esc(w.meaning)} · ${esc(langName[w.lang])}</div></div><span class="chip">不明 ${w.unknown||0} / 不安 ${w.unsure||0}</span></div>`).join(''):'まだ記録がありません。';}
function renderProgress(){const all=db.words;$('totalWords').textContent=all.length;$('masteredWords').textContent=all.filter(w=>w.mastered).length;const recent=db.events.slice(-50);const correct=recent.filter(e=>e.rate==='known').length;$('accuracy').textContent=recent.length?Math.round(correct/recent.length*100)+'%':'—';const chart=$('weeklyChart');chart.innerHTML='';const days=[];for(let i=6;i>=0;i--){const d=new Date();d.setDate(d.getDate()-i);const key=localDate(d);days.push({key,label:d.toLocaleDateString('ja-JP',{weekday:'short'}),n:db.events.filter(e=>e.date===key).length});}const max=Math.max(1,...days.map(d=>d.n));days.forEach(d=>{const el=document.createElement('div');el.className='barwrap';el.innerHTML=`<div class="bar" style="height:${Math.max(3,d.n/max*72)}px"></div><div>${d.label}</div><div>${d.n}</div>`;chart.appendChild(el)});$('languageStats').innerHTML=['ko','en','zh'].map(l=>`<div class="listitem row between"><span>${langName[l]}</span><b>${all.filter(w=>w.lang===l).length}語</b></div>`).join('');const counts={known:0,unsure:0,unknown:0};db.events.forEach(e=>counts[e.rate]=(counts[e.rate]||0)+1);$('ratingStats').textContent=`わかる ${counts.known}回 · 不安 ${counts.unsure}回 · わからない ${counts.unknown}回`;}
function renderLibrary(){const all=db.words;$('libraryCount').textContent=all.length+'語';const items=all.slice(-30).reverse();$('libraryList').innerHTML=items.length?items.map(w=>`<div class="listitem row between"><div style="min-width:0"><div class="wordmini">${esc(w.word)} <span class="small muted">${esc(w.pron||'')}</span></div><div class="small muted">${esc(langName[w.lang])} · ${esc(w.level||'')} · ${esc(w.topic||'')} · ${esc(w.meaning||'')}</div></div><button class="outline small" data-delete="${esc(w.id)}" style="padding:7px 9px">削除</button></div>`).join(''):'<div class="empty">単語がありません。</div>';document.querySelectorAll('[data-delete]').forEach(b=>b.addEventListener('click',()=>{if(confirm('この単語と学習履歴を削除しますか？')){const id=b.dataset.delete;db.words=db.words.filter(w=>w.id!==id);db.events=db.events.filter(e=>e.id!==id);save();renderLibrary();renderDashboard();}}));}
const AI_ENDPOINT_KEY='tango_ai_endpoint_v1';
try{$('aiEndpoint').value=localStorage.getItem(AI_ENDPOINT_KEY)||'';}catch(e){}
$('saveEndpointBtn').addEventListener('click',()=>{const value=$('aiEndpoint').value.trim();if(value&&!/^https:\/\//i.test(value)){$('aiStatus').textContent='https:// から始まるHTTPSのURLを入力してください。';return;}try{if(value)localStorage.setItem(AI_ENDPOINT_KEY,value);else localStorage.removeItem(AI_ENDPOINT_KEY);$('aiStatus').textContent=value?'API URLをこのブラウザに保存しました。':'API URLを消去しました。';}catch(e){$('aiStatus').textContent='保存できませんでした。ブラウザの保存設定を確認してください。';}});
function normalizeGeneratedItems(raw){if(!Array.isArray(raw))throw new Error('生成結果が配列ではありません。');return raw.map(item=>{if(!item||typeof item!=='object')return null;const word=String(item.word||'').trim(),meaning=String(item.meaning||'').trim();if(!word||!meaning)return null;const lang=['ko','en','zh'].includes(item.lang)?item.lang:$('genLang').value;const rawLevel=String(item.level||$('genLevel').value);const level=VOCAB_LEVELS.includes(rawLevel)?rawLevel:(rawLevel==='指定なし'?'初級':rawLevel==='初中級'?'初級':rawLevel==='英検1級相当'?'上級':rawLevel==='TOPIK 1級相当'||rawLevel==='HSK初級相当'?'入門':'初級');return classifyWord({lang,word,pron:String(item.pron||''),meaning,pos:String(item.pos||'未設定'),level,topic:String(item.topic||$('genTopic').value.trim()||'ランダム'),example:String(item.example||''),translation:String(item.translation||''),parts:String(item.parts||''),usageNote:String(item.usageNote||''),memoryHint:String(item.memoryHint||''),illustration:String(item.illustration||''),illustrationAlt:String(item.illustrationAlt||''),related:String(item.related||''),opposite:String(item.opposite||'特定の対義語なし')});}).filter(Boolean);}
function importGeneratedItems(items){let added=0,skipped=0;const seen=new Set(db.words.map(w=>idFor(w.lang,w.word)));for(const item of items){const id=idFor(item.lang,item.word);if(seen.has(id)){skipped++;continue;}seen.add(id);db.words.push({...item,id,createdAt:today(),seen:0,known:0,unsure:0,unknown:0,streak:0,interval:0,due:today(),lastSeen:null,mastered:false});added++;}save();renderLibrary();renderDashboard();renderProgress();renderReview();return {added,skipped};}
let aiPreviewItems=[];
function renderAiPreview(items){aiPreviewItems=items;const list=$('aiPreviewList');list.replaceChildren();items.forEach((item,index)=>{const label=document.createElement('label');label.className='ai-preview-item';const checkbox=document.createElement('input');checkbox.type='checkbox';checkbox.checked=true;checkbox.dataset.index=String(index);checkbox.setAttribute('aria-label',item.word+'を追加');const detail=document.createElement('div');detail.className='word-detail';const title=document.createElement('strong');title.textContent=`${item.word} — ${item.meaning}`;const meta=document.createElement('small');meta.textContent=`${item.level} / ${item.topic} / ${item.pos}${item.pron?' / '+item.pron:''}`;const example=document.createElement('small');example.textContent=item.example?`${item.example}${item.translation?' — '+item.translation:''}`:'例文なし';const related=document.createElement('small');related.textContent=`類義・関連語：${item.related||'なし'} ／ 反対語：${item.opposite||'なし'}`;detail.append(title,meta,example,related);label.append(checkbox,detail);list.append(label);});$('aiPreviewSummary').textContent=`${items.length}語の候補。初期状態では全語が選択されています。追加したい単語だけ残してください。`;}
$('directGenerateBtn').addEventListener('click',async()=>{const status=$('aiStatus'),endpoint=$('aiEndpoint').value.trim();if(!endpoint){status.textContent='先にAI中継APIのURLを設定してください。下の手動JSON取り込みは今までどおり使えます。';return;}if(!/^https:\/\//i.test(endpoint)){status.textContent='安全のためHTTPSのURLのみ利用できます。';return;}const count=Math.min(100,Math.max(1,Number($('genCount').value)||50));const request={lang:$('genLang').value,level:$('genLevel').value,topic:$('genTopic').value.trim()||'ランダム（複数テーマを幅広く）',pos:$('genPos').value,count,existingWords:db.words.filter(w=>w.lang===$('genLang').value).map(w=>w.word).slice(-1500)};const btn=$('directGenerateBtn');btn.disabled=true;status.textContent='AIが単語を生成しています。少し待ってね…';$('aiPreviewWrap').classList.add('hidden');try{const response=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(request)});let payload;try{payload=await response.json();}catch(e){throw new Error('APIからJSON以外の応答が返りました。URLとサーバー設定を確認してください。');}if(!response.ok)throw new Error(payload.error||('APIエラー（'+response.status+'）'));const items=normalizeGeneratedItems(payload.words||payload);if(!items.length)throw new Error('有効な単語がありませんでした。もう一度試してください。');$('aiPreview').value=JSON.stringify(items,null,2);renderAiPreview(items);$('aiPreviewWrap').classList.remove('hidden');status.textContent=`${items.length}語を生成しました。追加したい単語を選択してください。`; }catch(e){status.textContent='生成できませんでした：'+e.message+'（中継APIの公開・APIキー設定・利用上限を確認してください）';}finally{btn.disabled=false;}});
$('selectAllAiBtn').addEventListener('click',()=>{$('aiPreviewList').querySelectorAll('input[type=checkbox]').forEach(c=>c.checked=true);});
$('selectNoneAiBtn').addEventListener('click',()=>{$('aiPreviewList').querySelectorAll('input[type=checkbox]').forEach(c=>c.checked=false);});
$('importAiPreviewBtn').addEventListener('click',()=>{const status=$('aiStatus');try{const parsed=normalizeGeneratedItems(JSON.parse($('aiPreview').value));const selectedIndexes=new Set([...$('aiPreviewList').querySelectorAll('input[type=checkbox]:checked')].map(c=>Number(c.dataset.index)));const selected=parsed.filter((item,index)=>selectedIndexes.has(index));if(!selected.length){status.textContent='追加する単語を1つ以上選択してください。';return;}const result=importGeneratedItems(selected);status.textContent=`${result.added}語を追加、${result.skipped}語を重複のためスキップしました。`;if(result.added)$('aiPreviewWrap').classList.add('hidden');}catch(e){status.textContent='追加できません：'+e.message;}});
$('promptBtn').addEventListener('click',()=>{const lang=$('genLang').value,level=$('genLevel').value,topic=$('genTopic').value.trim()||'日常生活',pos=$('genPos').value,count=Number($('genCount').value);const prompt=`あなたは外国語語彙教材の編集者です。${langName[lang]}の単語学習データを${count}語生成してください。レベルは「${level}」、テーマは「${topic}」、品詞条件は「${pos}」です。類義語・反対語・例文とその日本語訳を含めてください。通常の語彙レベルは「入門・初級・中級・上級」の4段階です。入門には厳選した最重要語だけを割り当ててください。助詞などの文法項目や、数字・曜日など順番で覚える項目は通常語彙に混ぜず、既存の固定学習セットで扱います。初級=日常会話の基礎、中級=一般的な会話・文章、上級=抽象語・専門語・複雑な文章語です。レベルが「指定なし」の場合は通常語彙の4段階に分類してください。難易度とは別に、実際の使用頻度が高い語を優先し、動詞・形容詞・副詞・表現など品詞の偏りを避けてください。重複を避け、自然な語を選び、難易度を一貫させてください。出力はJSON配列のみ。説明文・Markdownコードフェンスは不要です。各要素は次のキーを持ちます：lang（${lang}）, word, pron（韓国語はローマ字、中国語は声調付きピンイン、英語はIPAまたは発音表記）, meaning（日本語訳）, pos, level（${level}）, topic（${topic}）, example（自然な例文）, translation（例文の日本語訳）, usageNote（語法・丁寧さ・混同しやすい点。単語固有で役立つ場合だけ短く、なければ空欄）, memoryHint（自然で確実な覚え方がある場合だけ。無理に作らず空欄）, illustration（同梱済みの画像ファイルの相対パス。画像がなければ空欄）, illustrationAlt（画像の短い説明）, parts（語の分解・語源。確実でない場合は「明確な分解なし」とし、誤った語源を作らない）, related（類義語・関連語と意味）, opposite（対義語。存在しない場合は「特定の対義語なし」）。語源・分解は事実に基づき、推測を断定しないこと。多義語は今回のテーマに合う意味を優先してください。JSONは正しい構文で、すべての文字列を二重引用符で囲んでください。`; $('promptOutput').value=prompt;});
$('copyPromptBtn').addEventListener('click',async()=>{const t=$('promptOutput').value;if(!t){$('importMessage').textContent='先にプロンプトを作成してください。';return;}try{await navigator.clipboard.writeText(t);$('importMessage').textContent='プロンプトをコピーしました。ChatGPTに貼り付けてください。';}catch(e){$('promptOutput').focus();$('promptOutput').select();$('importMessage').textContent='テキストを選択しました。コピーしてください。';}});
$('importBtn').addEventListener('click',()=>{const msg=$('importMessage');try{let raw=JSON.parse($('jsonInput').value.trim());if(!Array.isArray(raw))throw new Error('JSON配列を貼り付けてください。');let added=0,skipped=0;for(const item of raw){if(!item||!item.word||!item.meaning) {skipped++;continue;}const lang=['ko','en','zh'].includes(item.lang)?item.lang:$('genLang').value;const normalizedLevel=LEVELS.includes(item.level)?item.level:(item.level==='初中級'?'初級':item.level==='英検1級相当'?'上級':item.level==='TOPIK 1級相当'||item.level==='HSK初級相当'?'入門':'初級');const clean=classifyWord({...item,level:normalizedLevel});const id=idFor(lang,item.word);if(db.words.some(w=>w.id===id)){skipped++;continue;}db.words.push({...clean,lang,id,createdAt:today(),seen:0,known:0,unsure:0,unknown:0,streak:0,interval:0,due:today(),lastSeen:null,mastered:false});added++;}save();msg.textContent=`${added}語を追加しました。${skipped?skipped+'語は重複または必須項目不足のためスキップ。':''}`;msg.className='small';$('jsonInput').value='';renderLibrary();renderDashboard();}catch(e){msg.textContent='取り込みできません：'+e.message;msg.className='small dangertext';}});
function exportData(){return JSON.stringify({exportedAt:new Date().toISOString(),...db},null,2);}
$('exportBtn').addEventListener('click',()=>{$('backupWrap').classList.remove('hidden');$('backupOutput').value=exportData();});
